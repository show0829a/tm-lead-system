# Database Connection (PGLite / PostgreSQL wire protocol on 127.0.0.1:5433)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/tm_db"

# JWT Authentication Secret
JWT_SECRET="tm-lead-system-super-secret-jwt-token-key-2026-secure"

# AES-256-GCM Encryption Key (32 bytes = 64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Configuration
PORT=3000
PG_PORT=5433
PG_DATA_DIR="./.pglite-data"
